def print_help() -> int:
    sys.stdout.write(
        "Usage:\n"
        "  cx [--full] [codex exec args...] PROMPT\n"
        "  cx [--full] [codex exec args...] - < prompt.md\n"
        "  cx [--prompt-file FILE] [codex exec args...]\n"
        "  cx [--full] resume [codex exec resume args...]\n"
        "  cx show --last\n"
        "  cx show SESSION_ID\n"
        "\n"
        "Notes:\n"
        "  --full          Raw passthrough to `codex exec` (no clean formatting)\n"
        "  --no-progress   Disable clean-mode progress output on stderr\n"
        "  --quiet-progress Only show start/session/finish progress lines\n"
        "  --debug-json    Echo codex JSONL events to stderr while still cleaning stdout\n"
        "  --prompt-file   Read the prompt from a file and pass it through stdin\n"
        "  show            Parse local session JSONL files; does not contact Codex\n"
        "  All other args  Passed through to `codex exec`\n"
    )
    return 0


def print_show_help() -> int:
    sys.stdout.write(
        "Usage:\n"
        "  cx show --last\n"
        "  cx show SESSION_ID\n"
    )
    return 0


def main(argv: list[str]) -> int:
    if not argv or argv == ["--help"] or argv == ["-h"]:
        return print_help()

    try:
        options, filtered_args = parse_wrapper_args(argv)
    except ValueError as exc:
        sys.stderr.write(f"cx: {exc}\n")
        return 2

    if not filtered_args and options.prompt_file is None:
        return print_help()
    if not options.full_mode and (filtered_args == ["--help"] or filtered_args == ["-h"]):
        return print_help()

    try:
        prompt_input = prepare_prompt_input(filtered_args, options.prompt_file)
    except OSError as exc:
        sys.stderr.write(f"cx: {exc}\n")
        return 2
    except ValueError as exc:
        sys.stderr.write(f"cx: {exc}\n")
        return 2

    command = prompt_input.args[0]
    if command == "show":
        if options.prompt_file is not None:
            sys.stderr.write("cx show: --prompt-file is only valid for codex exec commands\n")
            return 2
        return handle_show(prompt_input.args[1:])

    if command == "resume":
        return handle_exec(prompt_input, options=options)

    return handle_exec(prompt_input, options=options)


def parse_wrapper_args(argv: list[str]) -> tuple[WrapperOptions, list[str]]:
    options = WrapperOptions()
    filtered_args: list[str] = []
    index = 0

    while index < len(argv):
        arg = argv[index]
        if arg == "--":
            filtered_args.extend(argv[index:])
            break
        if arg == "--full":
            options.full_mode = True
        elif arg == "--no-progress":
            options.progress_mode = "none"
        elif arg == "--quiet-progress":
            options.progress_mode = "quiet"
        elif arg == "--debug-json":
            options.progress_mode = "debug"
        elif arg == "--prompt-file":
            if index + 1 >= len(argv):
                raise ValueError("--prompt-file requires a file path")
            options.prompt_file = Path(argv[index + 1])
            index += 1
        elif arg.startswith("--prompt-file="):
            _name, _sep, value = arg.partition("=")
            if not value:
                raise ValueError("--prompt-file requires a file path")
            options.prompt_file = Path(value)
        else:
            filtered_args.append(arg)
        index += 1

    return options, filtered_args


def prepare_prompt_input(args: list[str], prompt_file: Path | None) -> PromptInput:
    if prompt_file is None:
        return PromptInput(args=args, summary=summarize_prompt_args(args))

    prompt_text = prompt_file.read_text(encoding="utf-8")
    updated_args = list(args)

    if not updated_args:
        updated_args = ["-"]
    elif updated_args[0] == "show":
        return PromptInput(args=updated_args, stdin_text=prompt_text)
    elif updated_args[0] == "resume":
        ensure_prompt_file_can_be_added(updated_args[1:], command_name="resume")
        if "-" not in positional_args(updated_args[1:]):
            updated_args.append("-")
    else:
        ensure_prompt_file_can_be_added(updated_args, command_name="exec")
        if "-" not in positional_args(updated_args):
            updated_args.append("-")

    return PromptInput(
        args=updated_args,
        stdin_text=prompt_text,
        summary=summarize_prompt_text(prompt_text, source=str(prompt_file)),
    )


def ensure_prompt_file_can_be_added(args: list[str], *, command_name: str) -> None:
    positional = positional_args(args)
    if command_name == "resume":
        if "--last" in args and positional and positional != ["-"]:
            raise ValueError("--prompt-file cannot be combined with an explicit resume prompt")
        if len(positional) <= 1 or (len(positional) == 2 and positional[-1] == "-"):
            return
        raise ValueError("--prompt-file cannot be combined with an explicit resume prompt")

    if not positional or positional == ["-"]:
        return
    raise ValueError("--prompt-file cannot be combined with an explicit prompt argument")


def handle_show(args: list[str]) -> int:
    if not args or args == ["--help"] or args == ["-h"]:
        return print_show_help()

    use_last = False
    session_id: str | None = None

    for arg in args:
        if arg == "--last":
            use_last = True
        elif arg.startswith("-"):
            sys.stderr.write(f"cx show: unsupported flag: {arg}\n")
            return 2
        elif session_id is None:
            session_id = arg
        else:
            sys.stderr.write("cx show: expected exactly one SESSION_ID or --last\n")
            return 2

    if use_last and session_id is not None:
        sys.stderr.write("cx show: use either --last or SESSION_ID, not both\n")
        return 2

    target = latest_session_file() if use_last else find_session_file_by_id(session_id)
    if target is None:
        detail = "most recent session" if use_last else f"session {session_id}"
        sys.stderr.write(f"cx show: could not find {detail}\n")
        return 1

    transcript = parse_session_transcript(target)
    render_transcript(transcript)
    return 0


def sandbox_base_flags(args: list[str]) -> list[str]:
    """Keep the default unless the caller explicitly selects a sandbox."""
    selected = any(
        a in ("-s", "--sandbox", "--dangerously-bypass-approvals-and-sandbox")
        or a.startswith("--sandbox=")
        or (a.startswith("-s") and not a.startswith("--") and len(a) > 2)
        for a in args
    )
    return [] if selected else ["-s", "danger-full-access"]


def handle_exec(prompt_input: PromptInput, *, options: WrapperOptions) -> int:
    args = prompt_input.args

    if not options.full_mode and find_reserved_clean_flags(args):
        flags = ", ".join(sorted(find_reserved_clean_flags(args)))
        sys.stderr.write(
            f"cx: {flags} are reserved in clean mode; use `cx --full ...` for raw codex flags\n"
        )
        return 2

    if args[0] == "resume":
        root_flags, resume_args = hoist_resume_root_flags(args[1:])
        if "--last" in resume_args and not sys.stdin.isatty():
            sys.stderr.write(
                'cx: --last is not allowed in non-interactive mode. '
                'Use an explicit session ID: cx resume SESSION_ID "prompt"\n'
            )
            return 2
        sandbox_flags = sandbox_base_flags([*root_flags, *resume_args])
        cmd = [*CODEX_CMD, "exec", *sandbox_flags, "--skip-git-repo-check"]
        if options.full_mode:
            cmd.extend(root_flags)
            cmd.append("resume")
            cmd.extend(resume_args)
            return run_full_mode(cmd, stdin_text=prompt_input.stdin_text)

        return run_clean_mode(
            [*CODEX_CMD, "exec", *sandbox_flags, "--skip-git-repo-check", "--json", *root_flags],
            ["resume", *resume_args],
            options=options,
            prompt_summary=prompt_input.summary,
            stdin_text=prompt_input.stdin_text,
        )

    sandbox_flags = sandbox_base_flags(args)
    cmd = [*CODEX_CMD, "exec", *sandbox_flags, "--skip-git-repo-check", *args]
    if options.full_mode:
        return run_full_mode(cmd, stdin_text=prompt_input.stdin_text)
    return run_clean_mode(
        [*CODEX_CMD, "exec", *sandbox_flags, "--skip-git-repo-check", "--json"],
        args,
        options=options,
        prompt_summary=prompt_input.summary,
        stdin_text=prompt_input.stdin_text,
    )


def run_full_mode(cmd: list[str], *, stdin_text: str | None = None) -> int:
    completed = subprocess.run(cmd, input=stdin_text, text=stdin_text is not None)
    return completed.returncode


def run_clean_mode(
    base_cmd: list[str],
    tail_args: list[str],
    *,
    options: WrapperOptions,
    prompt_summary: str | None,
    stdin_text: str | None = None,
) -> int:
    temp_path: Path | None = None
    stderr_lines: list[str] = []
    stderr_queue: queue.Queue[str] = queue.Queue()
    stdout_queue: queue.Queue[str] = queue.Queue()
    process: subprocess.Popen[str] | None = None
    stdin_thread: threading.Thread | None = None
    try:
        with tempfile.NamedTemporaryFile(prefix="cx-", suffix=".md", delete=False) as handle:
            temp_path = Path(handle.name)

        cmd = [*base_cmd, "-o", str(temp_path), *tail_args]
        progress = ProgressReporter(options.progress_mode, prompt_summary)
        progress.start()

        process = subprocess.Popen(
            cmd,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            stdin=subprocess.PIPE if stdin_text is not None else None,
            text=True,
            encoding="utf-8",
            bufsize=1,
        )

        stdout_thread = threading.Thread(
            target=enqueue_stream_lines,
            args=(process.stdout, stdout_queue),
            daemon=True,
        )
        stderr_thread = threading.Thread(
            target=enqueue_stream_lines,
            args=(process.stderr, stderr_queue),
            daemon=True,
        )
        stdout_thread.start()
        stderr_thread.start()

        if stdin_text is not None and process.stdin is not None:
            stdin_thread = threading.Thread(
                target=write_process_stdin,
                args=(process.stdin, stdin_text),
                daemon=True,
            )
            stdin_thread.start()

        json_result = ExecJsonResult()
        state = ProgressState()

        while (
            process.poll() is None
            or stdout_thread.is_alive()
            or stderr_thread.is_alive()
            or not stdout_queue.empty()
            or not stderr_queue.empty()
        ):
            drain_stderr_queue(stderr_queue, stderr_lines)
            try:
                raw_line = stdout_queue.get(timeout=1)
            except queue.Empty:
                progress.heartbeat()
                continue

            update_exec_json_from_line(raw_line, json_result)
            progress.event(raw_line, json_result, state)

        stdout_thread.join(timeout=1)
        stderr_thread.join(timeout=1)
        if stdin_thread is not None:
            stdin_thread.join(timeout=1)
        drain_stderr_queue(stderr_queue, stderr_lines)

        completed_returncode = process.wait()
        last_message = read_last_message(temp_path)

        meta: SessionMeta | None = None
        if json_result.thread_id:
            session_file = find_session_file_by_id(json_result.thread_id)
            if session_file:
                meta = parse_session_meta(session_file)

        if json_result.turn_completed and completed_returncode == 0:
            progress.finish(success=True)
            emit_clean_success(last_message, json_result.thread_id, meta)
            return 0

        error_text = json_result.error_message or first_relevant_error_line("".join(stderr_lines))
        if not error_text and json_result.parse_error:
            error_text = json_result.parse_error
        if not error_text and completed_returncode != 0:
            error_text = f"codex exited with status {completed_returncode}"
        if not error_text and not json_result.turn_completed:
            error_text = "codex did not emit turn.completed"

        progress.finish(success=False)
        sys.stderr.write(f"cx: {error_text}\n")
        return completed_returncode or 1
    except FileNotFoundError:
        sys.stderr.write("cx: `codex` not found on PATH\n")
        return 127
    finally:
        if process is not None and process.poll() is None:
            process.kill()
        if temp_path is not None:
            try:
                temp_path.unlink(missing_ok=True)
            except OSError:
                pass


class ProgressReporter:
    def __init__(self, mode: str, prompt_summary: str | None) -> None:
        self.mode = mode
        self.prompt_summary = prompt_summary
        self.last_activity_at = time.monotonic()
        self.last_event_line_at = 0.0
        self.warned_after_silence = False

    @property
    def enabled(self) -> bool:
        return self.mode != "none"

    def start(self) -> None:
        if not self.enabled:
            return
        self.emit("starting codex exec")
        if self.prompt_summary and self.mode != "quiet":
            self.emit(self.prompt_summary)

    def event(self, raw_line: str, result: ExecJsonResult, state: ProgressState) -> None:
        self.last_activity_at = time.monotonic()
        self.warned_after_silence = False
        if not self.enabled:
            return

        line = raw_line.strip()
        if not line:
            return

        if self.mode == "debug":
            self.emit(f"json: {line}")

        try:
            payload = json.loads(line)
        except json.JSONDecodeError:
            return

        event_type = payload.get("type")
        if event_type == "thread.started" and not state.emitted_session:
            thread_id = payload.get("thread_id") or result.thread_id
            if thread_id:
                self.emit(f"session: {thread_id}")
                state.emitted_session = True

        if result.thread_id and not state.emitted_meta and self.mode != "quiet":
            if self.emit_meta_if_available(result.thread_id):
                state.emitted_meta = True

        if self.mode == "quiet":
            return

        if event_type == "turn.started":
            self.emit("turn started")
        elif event_type == "turn.completed":
            self.emit("turn completed")
        elif event_type == "turn.failed":
            self.emit("turn failed")
        elif event_type != "thread.started":
            self.emit_rate_limited_event(event_type)

    def heartbeat(self) -> None:
        if not self.enabled or self.mode == "quiet":
            return
        now = time.monotonic()
        silent_for = now - self.last_activity_at
        if silent_for < PROGRESS_WARNING_SECONDS:
            return
        if self.warned_after_silence:
            return
        self.emit(
            f"Warning: no Codex events for {format_duration(silent_for)}; "
            "Codex may be waiting on a tool/subprocess"
        )
        self.warned_after_silence = True

    def finish(self, *, success: bool) -> None:
        if self.enabled:
            self.emit("finished" if success else "finished with error")

    def emit_rate_limited_event(self, event_type: object) -> None:
        if not isinstance(event_type, str):
            return
        now = time.monotonic()
        if now - self.last_event_line_at < 5:
            return
        self.emit(f"event: {event_type}")
        self.last_event_line_at = now

    def emit_meta_if_available(self, thread_id: str) -> bool:
        session_file = find_session_file_by_id(thread_id)
        if not session_file:
            return False

        meta = parse_session_meta(session_file)
        lines: list[str] = []
        if meta.cli_version:
            lines.append(f"codex: {meta.cli_version}")
        if meta.cwd:
            lines.append(f"workdir: {meta.cwd}")
        if meta.model:
            lines.append(f"model: {meta.model}")
        if meta.model_provider:
            lines.append(f"provider: {meta.model_provider}")
        if meta.approval:
            lines.append(f"approval: {meta.approval}")
        if meta.sandbox:
            lines.append(f"sandbox: {meta.sandbox}")
        if meta.effort:
            lines.append(f"reasoning effort: {meta.effort}")

        if not lines:
            return False

        for line in lines:
            self.emit(line)
        return True

    def emit(self, message: str) -> None:
        sys.stderr.write(f"[{time.strftime('%H:%M:%S')}] cx: {message}\n")
        sys.stderr.flush()


def enqueue_stream_lines(stream: object, output_queue: queue.Queue[str]) -> None:
    if stream is None:
        return
    for line in stream:
        output_queue.put(line)


def write_process_stdin(stream: object, text: str) -> None:
    try:
        stream.write(text)
        if not text.endswith("\n"):
            stream.write("\n")
        stream.flush()
    finally:
        stream.close()


def drain_stderr_queue(stderr_queue: queue.Queue[str], stderr_lines: list[str]) -> None:
    while True:
        try:
            stderr_lines.append(stderr_queue.get_nowait())
        except queue.Empty:
            return


def summarize_prompt_args(args: list[str]) -> str | None:
    if not args or args[0] == "show":
        return None

    if args[0] == "resume":
        positional = positional_args(args[1:])
        if "-" in positional:
            return "input: stdin prompt (-)"
        if "--last" in args and positional:
            return summarize_prompt_text(positional[-1], source="argument")
        if len(positional) >= 2:
            return summarize_prompt_text(positional[-1], source="argument")
        return None

    positional = positional_args(args)
    if "-" in positional:
        return "input: stdin prompt (-)"
    if positional:
        return summarize_prompt_text(positional[-1], source="argument")
    return None


def summarize_prompt_text(text: str, *, source: str) -> str:
    line_count = len(text.splitlines()) or (1 if text else 0)
    preview = first_nonempty_line(text) or ""
    preview = preview.replace("\t", " ")
    if len(preview) > 120:
        preview = f"{preview[:117]}..."
    if preview:
        return f"input: {source}, {len(text)} chars, {line_count} lines, preview: {preview!r}"
    return f"input: {source}, {len(text)} chars, {line_count} lines"


def format_duration(seconds: float) -> str:
    total = int(seconds)
    minutes, remainder = divmod(total, 60)
    if minutes:
        return f"{minutes}m {remainder}s"
    return f"{remainder}s"


def positional_args(args: list[str]) -> list[str]:
    positional: list[str] = []
    index = 0
    while index < len(args):
        token = args[index]

        if token == "--":
            positional.extend(args[index + 1 :])
            break

        if token in POSITIONAL_FLAGS_NO_VALUE:
            index += 1
            continue

        if token in POSITIONAL_FLAGS_WITH_VALUE:
            index += 2 if index + 1 < len(args) else 1
            continue

        if token.startswith("--"):
            name, sep, _value = token.partition("=")
            if sep and name in POSITIONAL_FLAGS_WITH_VALUE:
                index += 1
                continue

        if token.startswith("-") and token != "-":
            index += 1
            continue

        positional.append(token)
        index += 1

    return positional


def parse_exec_json(stdout_text: str) -> ExecJsonResult:
    result = ExecJsonResult()
    for raw_line in stdout_text.splitlines():
        update_exec_json_from_line(raw_line, result)
    return result


def update_exec_json_from_line(raw_line: str, result: ExecJsonResult) -> None:
    line = raw_line.strip()
    if not line:
        return
    try:
        payload = json.loads(line)
    except json.JSONDecodeError as exc:
        result.parse_error = f"invalid JSON from codex exec: {exc}"
        return

    event_type = payload.get("type")
    if event_type == "thread.started" and not result.thread_id:
        result.thread_id = payload.get("thread_id")
    elif event_type == "turn.completed":
        result.turn_completed = True
    elif event_type == "turn.failed":
        result.turn_failed = True
        result.error_message = (
            nested_get(payload, "error", "message")
            or payload.get("message")
            or "turn failed"
        )
    elif event_type == "error" and not result.error_message:
        result.error_message = payload.get("message") or "event stream error"


def emit_clean_success(message: str, thread_id: str | None, meta: SessionMeta | None = None) -> None:
    if meta:
        emit_meta_header(meta)
    if message:
        sys.stdout.write(message)
        if not message.endswith("\n"):
            sys.stdout.write("\n")
    if thread_id:
        if message or meta:
            sys.stdout.write("\n")
        sys.stdout.write(f"Session: {thread_id}\n")


def emit_meta_header(meta: SessionMeta) -> None:
    version = f"OpenAI Codex v{meta.cli_version}" if meta.cli_version else "OpenAI Codex"
    sys.stdout.write(f"{version}\n")
    sys.stdout.write("--------\n")
    if meta.cwd:
        sys.stdout.write(f"workdir: {meta.cwd}\n")
    if meta.model:
        sys.stdout.write(f"model: {meta.model}\n")
    if meta.model_provider:
        sys.stdout.write(f"provider: {meta.model_provider}\n")
    if meta.approval:
        sys.stdout.write(f"approval: {meta.approval}\n")
    if meta.sandbox:
        sys.stdout.write(f"sandbox: {meta.sandbox}\n")
    if meta.effort:
        sys.stdout.write(f"reasoning effort: {meta.effort}\n")
    sys.stdout.write("--------\n\n")


def read_last_message(path: Path) -> str:
    try:
        return path.read_text(encoding="utf-8")
    except FileNotFoundError:
        return ""


def latest_session_file() -> Path | None:
    candidates = list(iter_session_files())
    if not candidates:
        return None
    return max(candidates, key=lambda path: (path.stat().st_mtime_ns, str(path)))


def find_session_file_by_id(session_id: str | None) -> Path | None:
    if not session_id:
        return None
    suffix = f"-{session_id}.jsonl"
    matches = [path for path in iter_session_files() if path.name.endswith(suffix)]
    if matches:
        return max(matches, key=lambda path: (path.stat().st_mtime_ns, str(path)))
    return None


def iter_session_files() -> Iterable[Path]:
    if not SESSIONS_ROOT.is_dir():
        return []
    return SESSIONS_ROOT.rglob("*.jsonl")


def parse_session_meta(path: Path) -> SessionMeta:
    meta = SessionMeta()
    with path.open("r", encoding="utf-8") as handle:
        for raw_line in handle:
            line = raw_line.strip()
            if not line:
                continue
            try:
                entry = json.loads(line)
            except json.JSONDecodeError:
                continue

            entry_type = entry.get("type")
            payload = entry.get("payload", {})

            if entry_type == "session_meta":
                meta.cli_version = payload.get("cli_version") or meta.cli_version
                meta.cwd = payload.get("cwd") or meta.cwd
                meta.model_provider = payload.get("model_provider") or meta.model_provider
            elif entry_type == "turn_context":
                meta.model = payload.get("model") or meta.model
                meta.effort = payload.get("effort") or meta.effort
                meta.approval = payload.get("approval_policy") or meta.approval
                if payload.get("cwd"):
                    meta.cwd = payload["cwd"]
                sandbox = payload.get("sandbox_policy")
                if isinstance(sandbox, dict):
                    stype = sandbox.get("type") or sandbox.get("mode") or ""
                    writable = sandbox.get("writable_roots", [])
                    net = sandbox.get("network_access", False)
                    parts = [stype]
                    if writable:
                        roots = ", ".join(str(r) for r in writable)
                        parts.append(f"[{roots}]")
                    if net:
                        parts.append("(network access enabled)")
                    meta.sandbox = " ".join(parts)
    return meta


def parse_session_transcript(path: Path) -> SessionTranscript:
    session_id: str | None = None
    cwd: str | None = None
    model: str | None = None
    messages: list[SessionMessage] = []

    with path.open("r", encoding="utf-8") as handle:
        for raw_line in handle:
            line = raw_line.strip()
            if not line:
                continue
            try:
                entry = json.loads(line)
            except json.JSONDecodeError:
                continue

            entry_type = entry.get("type")
            payload = entry.get("payload", {})

            if entry_type == "session_meta":
                session_id = payload.get("id") or session_id
                cwd = payload.get("cwd") or cwd
            elif entry_type == "turn_context":
                model = payload.get("model") or model
            elif entry_type == "response_item":
                if payload.get("type") != "message" or payload.get("role") != "user":
                    continue
                text = extract_content_text(payload.get("content"))
                if text and not text.lstrip().startswith("<"):
                    messages.append(SessionMessage(role="user", text=text))
            elif entry_type == "event_msg" and payload.get("type") == "item_completed":
                item = payload.get("item", {})
                if item.get("type") == "AgentMessage":
                    text = extract_agent_message_text(item)
                    if text:
                        messages.append(
                            SessionMessage(role="assistant", text=text, phase=item.get("phase"))
                        )
            elif entry_type == "event_msg" and payload.get("type") == "agent_message":
                text = extract_agent_message_text(payload)
                if text:
                    messages.append(
                        SessionMessage(
                            role="assistant",
                            text=text,
                            phase=payload.get("phase"),
                        )
                    )

    return SessionTranscript(session_id=session_id, cwd=cwd, model=model, path=path, messages=messages)


def render_transcript(transcript: SessionTranscript) -> None:
    if transcript.session_id:
        sys.stdout.write(f"Session: {transcript.session_id}\n")
    if transcript.cwd:
        sys.stdout.write(f"CWD: {transcript.cwd}\n")
    if transcript.model:
        sys.stdout.write(f"Model: {transcript.model}\n")
    sys.stdout.write(f"File: {transcript.path}\n")

    for message in transcript.messages:
        if message.role == "user":
            heading = "User"
        elif message.phase and message.phase != "final_answer":
            heading = f"Assistant [{message.phase}]"
        else:
            heading = "Assistant"
        sys.stdout.write(f"\n{heading}:\n{message.text.rstrip()}\n")


def extract_content_text(content: object) -> str:
    if isinstance(content, str):
        return content
    if not isinstance(content, list):
        return ""

    parts: list[str] = []
    for item in content:
        if isinstance(item, str):
            parts.append(item)
            continue
        if not isinstance(item, dict):
            continue
        text = item.get("text")
        if isinstance(text, str):
            parts.append(text)
    return "\n".join(part for part in parts if part).strip()


def extract_agent_message_text(payload: dict[str, object]) -> str:
    message = payload.get("message")
    if isinstance(message, str):
        return message

    content = payload.get("content")
    if isinstance(content, str):
        return content
    return extract_content_text(content)


def hoist_resume_root_flags(args: list[str]) -> tuple[list[str], list[str]]:
    hoisted: list[str] = []
    remaining: list[str] = []
    index = 0

    while index < len(args):
        token = args[index]

        if token == "--":
            remaining.extend(args[index:])
            break

        consumed = consume_root_flag(args, index)
        if consumed is None:
            remaining.append(token)
            index += 1
            continue

        hoisted.extend(consumed)
        index += len(consumed)

    return hoisted, remaining


def consume_root_flag(args: list[str], index: int) -> list[str] | None:
    token = args[index]

    if token in ROOT_FLAGS_NO_VALUE:
        return [token]

    if token in ROOT_FLAGS_WITH_VALUE:
        if index + 1 >= len(args):
            return [token]
        return [token, args[index + 1]]

    if token.startswith("--"):
        name, sep, _value = token.partition("=")
        if sep and name in ROOT_FLAGS_WITH_VALUE:
            return [token]

    return None


def find_reserved_clean_flags(args: list[str]) -> set[str]:
    found: set[str] = set()
    index = 0
    while index < len(args):
        token = args[index]
        if token in RESERVED_CLEAN_FLAGS:
            found.add(token)
            if token in {"-o", "--output-last-message"} and index + 1 < len(args):
                index += 2
                continue
        elif token.startswith("--output-last-message="):
            found.add("--output-last-message")
        index += 1
    return found


def nested_get(payload: dict[str, object], *keys: str) -> str | None:
    value: object = payload
    for key in keys:
        if not isinstance(value, dict):
            return None
        value = value.get(key)
    return value if isinstance(value, str) else None


def first_nonempty_line(text: str) -> str | None:
    for line in text.splitlines():
        stripped = line.strip()
        if stripped:
            return stripped
    return None


def first_relevant_error_line(text: str) -> str | None:
    ignored_prefixes = (
        "Reading additional input from stdin",
        "WARNING: proceeding, even though we could not update PATH:",
    )
    for line in text.splitlines():
        stripped = line.strip()
        if not stripped:
            continue
        if stripped.startswith(ignored_prefixes):
            continue
        return stripped
    return None


